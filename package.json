{
  "name": "elerose_backend",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=dev cross-env tsx watch src/main.ts",
    "migration:generate": "tsx ./node_modules/typeorm/cli.js migration:generate -d ./src/config/database/database.config.ts",
    "migration:run:dev": "cross-env NODE_ENV=dev tsx ./node_modules/typeorm/cli.js migration:run -d ./src/config/database/database.config.ts",
    "migration:run:prod": "cross-env NODE_ENV=prod tsx ./node_modules/typeorm/cli.js migration:run -d ./src/config/database/database.config.ts",
    "migration:run:test": "cross-env NODE_ENV=test tsx ./node_modules/typeorm/cli.js migration:run -d ./src/config/database/database.config.ts",
    "build": "tsc",
    "start": "tsc && node dist/main.js",
    "test": "cross-env RUNNING_TESTS=true vitest run"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@smithy/node-http-handler": "^4.12.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "reflect-metadata": "^0.2.2",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.31",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.3.0",
    "@types/supertest": "^7.2.1"
  }
}
